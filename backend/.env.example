# Application Configuration
APP_NAME=LibrisQuest
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=librisquest_db

# Legacy Template DB Connection (for Phase 0 migration)
APPS_DB_URI=mysql+aiomysql://root:@localhost:3306/librisquest_db
APPS_DB_NAME=librisquest_db

# Auth & Security (JWT)
AUTH_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXP=1440
AUTH_REFRESH_TOKEN_EXP=10080
AUTH_REFRESH_TOKEN_REMEMBER_EXP=43200

# Telegram Logs & Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=

# Whitelist CORS Origins (comma separated)
ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
